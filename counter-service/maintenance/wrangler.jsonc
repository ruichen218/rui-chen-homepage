{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rui-chen-counter-maintenance",
  "main": "src/entry.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "MAIN_API_BASE": "https://rui-chen-homepage-counter.cr20010218.workers.dev"
  },
  "services": [{ "binding": "COUNTER_SERVICE", "service": "rui-chen-homepage-counter" }],
  "d1_databases": [
    {
      "binding": "SOURCE_DB",
      "database_name": "rui-chen-homepage-counter",
      "database_id": "00000000-0000-0000-0000-000000000000"
    },
    {
      "binding": "ARCHIVE_DB",
      "database_name": "rui-chen-counter-backups",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] }
}
